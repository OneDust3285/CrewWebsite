<!DOCTYPE html>

<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" />
    <title>Past Events</title>
    <link rel="stylesheet" href="/index.css" />
    <style>
        .event-card a {
            color: white;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <%- include('./partials/header') %>
    <div class="page" style="background-image: url('/assets/default_background.jpg');">
        <div class="content">
            <h1>Future Events</h1>
            <% events.forEach(event => { %>
                <div class="event-card">
                    <h2><a href="/event/<%= event.id %>"><%= event.title %></a></h2>
                    <p><%= event.content %></p>
                    <p>Author: <%= event.author %></p>
                </div>
            <% }) %>
            <form action="/newevent" method="POST">
                <h2>Add New Event</h2>
                <input type="text" name="title" placeholder="Event Title" required />
                <textarea name="content" placeholder="Event Content" required></textarea>
                <input type="hidden" name="author" value="<%= userId %> <%= userData.lastName %>" />
                <% if (!userId) { %>
                    <p style="color: red;">Note: You must be signed in to add an event.</p>
                <% } %>
                <button type="submit" <%= !userId ? 'disabled' : '' %>>Add Event</button>
                <p style="color: red;">Warning: This will add an event to the future events page. Please make sure the event is appropriate and accurate.</p>
                <p style="color: red;">This form is not protected against spam or abuse. Please do not use it to add inappropriate content.</p>
                <p style="color: red;">If you need to edit or remove an event, please contact the site administrator.</p>
                <p style="color: red;">This form is intended for use by crew members and leaders to share upcoming events with the crew. Please use it responsibly.</p>
                <% if(locals.error) { %>
                    <p style="color: red;"><%= locals.error %></p>
                <% } %>
            </form>
        </div>
    </div>
</body>
</html>