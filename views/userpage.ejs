<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CREW 1548</title>
    <link rel="stylesheet" href="/index.css" />
</head>
<body>
    <%- include('./partials/header') %>
    <div class='page' style="background-image:url('/assets/default_background.jpg');">
        <div class="content">
            <h1><%= userData.firstName %> <%= userData.lastName %></h1>
            <% if (isOwner) { %>
                <p> Private Dashbord </p>
                <form action="/updateuser" method="POST">
                    <input type="email" name="email" placeholder="Email"/>
                    <textarea name="content" placeholder="Type your description of yourself here!" maxlength="100"></textarea>
                    <button type="submit">Update Profile</button>
                    <p style="color: red;">Max Charactor limit of 100</p>
                </form>
            <% } else { %>
                <p> Public Profile </p>
                <p><%= userData.email %></p>
                <p><%= userData.content %></p>
            <% } %>
        </div>
    </div>
</body>
</html>